# =====================================================
# .env file
# Put your MySQL credentials here
# WARNING: Never commit this file to a public GitHub repo
# =====================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=college_exam_portal

# Only needed when using a cloud MySQL provider that requires SSL (e.g. Aiven).
# Leave blank for local MySQL — see the deployment guide for details.
MYSQL_SSL_CA=

SECRET_KEY=change-this-to-a-long-random-secret-key

# =====================================================
# Email settings (used for "Forgot Password" OTP emails)
# If you leave these as-is (not configured), the app will still work —
# it will just show the OTP directly on screen instead of emailing it,
# so you can keep testing without setting up email right away.
#
# To use real Gmail: turn on 2-Step Verification on your Google account,
# then create an "App Password" (myaccount.google.com/apppasswords)
# and paste that 16-character password below — NOT your normal Gmail password.
# =====================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
